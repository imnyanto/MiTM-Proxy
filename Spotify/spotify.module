#!name=Spotify Premium
#!desc=by Mint
#!url=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/refs/heads/main/Spotify/spotify.module
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
#!homepage=https://github.com/imnyanto/MiTM-Proxy/tree/main/Spotify
#!author=imnyanto
#!system=ios

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[URL Rewrite]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-dict
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer) - reject

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del 'if-none-match'
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$ header-del 'if-none-match'
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/pam-view-service\/ header-del 'if-none-match'

[Script]
Spotify gabo = type=http-request, pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-gabo.js, timeout=10
Spotify search ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-NoSearchAd.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify home ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-NoHomeAd.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify scroll ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-NoScrollAd.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify protobuf (local) = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify protobuf (app 9.1.98+ configuration and attributes) = type=http-response, pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify plan label = type=http-response, pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/pam-view-service\/spotify\.pam\.v2\.PamViewService\/GetPlanOverview$, script-path=https://raw.githubusercontent.com/imnyanto/MiTM-Proxy/main/Spotify/response/spot-plan-label.js, requires-body=true, binary-body-mode=true, timeout=10

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
